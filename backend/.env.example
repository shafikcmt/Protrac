DEBUG=True
SECRET_KEY=your_secret_key
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT Token Lifetime
JWT_ACCESS_TOKEN_LIFETIME_DAYS=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=90

# Email / SMTP (used by the automated Daily Production Report mailer).
# These names match core/settings.py exactly. Fill real values in your own
# local .env — never commit real credentials. NOTE: when DEBUG=True the app
# uses the console email backend (prints instead of sending); set DEBUG=False
# to actually send over SMTP.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_smtp_username
# EMAIL_HOST_PASSWORD=your_smtp_password
# DEFAULT_FROM_EMAIL=Production Tracking <no-reply@example.com>
